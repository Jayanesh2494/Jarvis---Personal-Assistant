<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="jarvis.db" />
        <exclude domain="sharedpref" path="jarvis_prefs" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="jarvis.db" />
        <include domain="sharedpref" path="jarvis_prefs" />
    </device-transfer>
</data-extraction-rules>
